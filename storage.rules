rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos aprobadas: lectura pública, escritura solo admin
    match /fotos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Pendientes: el formulario de familias se retiró el 2026-09-08; solo admin
    match /pending/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
